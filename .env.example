# Copy this file to ".env" and fill in your own values before running the site.

# Port the server listens on
PORT=3000

# Public base URL of your deployed site (used to build Paystack callback links).
# For local testing this can stay as http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Password the seller uses to log in to /admin. Change this to something strong.
ADMIN_PASSWORD=change-this-password

# Long random string used to sign admin session cookies. Change this to something random.
SESSION_SECRET=change-this-to-a-long-random-string

# --- Paystack (Nigerian payments) ---
# Get these from https://dashboard.paystack.com/#/settings/developer
# Leave both blank to run in DEMO PAYMENT MODE (no real charges), useful for testing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Shipping ---
# Fee (in Naira) applied to any state that is not explicitly listed in the
# shipping_rates table and not Lagos. Lagos is always free shipping.
DEFAULT_SHIPPING_FEE=3500
